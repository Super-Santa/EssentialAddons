{
  "schemaVersion": 1,
  "id": "essentialaddons",
  "version": "${version}",
  "name": "Essential Addons",
  "description": "A carpet extension adding many things from the Spigot plugin Essentials, as well as other useful features.",
  "authors": [
    "SuperSanta",
    "Sensei"
  ],
  "contributors": [
    "PROCESS",
    "Willowsticks",
    "Crec0",
    "BisUmTo",
    "Altrisi"
  ],
  "contact": {
    "sources": "https://github.com/Super-Santa/EssentialAddons",
    "issues": "https://github.com/Super-Santa/EssentialAddons/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "essentialaddons.EssentialAddons"
    ],
    "server": [
      "essentialaddons.utils.EssentialRuleGenerator"
    ]
  },
  "mixins": [
    "essentialaddons.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "${minecraft_dependency}",
    "fabric": "*"
  }
}
